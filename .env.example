# Copy to .env at the vclogic-suite root. Research commands inherit this file.
# Shell-exported values take precedence. Values are literal (no ${...} expansion).
# No-key test/demo/verify commands do not load this file.
# Never commit populated credentials or pass them as Docker build arguments.

# Assessment and optional Pitch Show decision extraction (native default provider):
OPENROUTER_API_KEY=
# Set only if your native assessment configuration selects OpenAI:
OPENAI_API_KEY=

# Optional collector search and OpenAI-compatible discovery provider:
VC_TRACE_SEARCH_ENDPOINT=
VC_TRACE_LLM_ENDPOINT=
VC_TRACE_LLM_API_KEY=
VC_TRACE_DISCOVERY_MODEL=

# Optional gated Hugging Face models and AV device:
HF_TOKEN=
VC_TRACE_AV_DEVICE=cpu

# Memory full-build uses installed, authenticated Codex CLI.
# The keys above do not replace Codex authentication.
# Model choices, budgets and research contracts stay in native configurations.
