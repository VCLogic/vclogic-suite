# Copy to .env at the vclogic-suite root and paste values after "=" (no quotes).
# README.md, "Fill in .env", explains each variable and where to get it.
# Shell-exported values take precedence. Values are literal (no ${...} expansion).
# The no-key test/demo commands do not load this file. Never commit it.

# --- Required for a new investor ---
# LLM calls in assess and web (https://openrouter.ai/keys):
OPENROUTER_API_KEY=
# Collector voice step; also accept pyannote/speaker-diarization-3.1 and
# pyannote/segmentation-3.0 on Hugging Face (https://huggingface.co/settings/tokens):
HF_TOKEN=

# --- Optional ---
# cpu (default) or cuda for an NVIDIA GPU:
VC_TRACE_AV_DEVICE=cpu
# Only if an assessment config selects the OpenAI provider:
OPENAI_API_KEY=
# Only behind an HTTP(S) proxy (otherwise the collector times out):
# VC_TRACE_ALLOW_ENV_PROXY=1
# NODE_USE_ENV_PROXY=1
# Own SearXNG JSON endpoint; blank = default public search:
VC_TRACE_SEARCH_ENDPOINT=
# Model-assisted discovery; all three together or none:
VC_TRACE_LLM_ENDPOINT=
VC_TRACE_LLM_API_KEY=
VC_TRACE_DISCOVERY_MODEL=

# Not configured here: memory generation uses your Codex or Claude Code login,
# and Agent Reach/Exa search is configured through mcporter.

# --- Collector configuration examples (comments only) ---
# Default discovery: leave VC_TRACE_SEARCH_ENDPOINT and all three
# VC_TRACE_LLM_* / VC_TRACE_DISCOVERY_MODEL settings blank.
#
# Proxy: enable these only when your environment already supplies a proxy.
# VC_TRACE_ALLOW_ENV_PROXY=1
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.example.org:8080
# HTTP_PROXY=http://proxy.example.org:8080
# The proxy hostname above is a placeholder, not a working service.
#
# Optional search override: use your own SearXNG JSON search endpoint.
# VC_TRACE_SEARCH_ENDPOINT=https://search.example.org/search
# The hostname above is a placeholder; leave blank to use default search.
#
# Optional model-assisted discovery: use your provider's full chat-completions
# URL, an actual API key, and a model ID supported by that provider.
# VC_TRACE_LLM_ENDPOINT=https://llm.example.org/v1/chat/completions
# VC_TRACE_LLM_API_KEY=replace-with-your-provider-key
# VC_TRACE_DISCOVERY_MODEL=replace-with-your-provider-model-id
# These are placeholders, not working credentials or a recommended model.
# All three values are required to enable discovery refinement. Also configure
# an explicit discovery-call budget in the native collector workflow, e.g.
# --discovery-call-budget-usd 0.50 (illustrative reservation, not a price quote).
# OPENROUTER_API_KEY is not automatically reused as VC_TRACE_LLM_API_KEY.
# Values are literal: do not use ${OPENROUTER_API_KEY} as a substitute.
# --- End collector configuration examples ---
